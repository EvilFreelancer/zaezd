# Copy to .env and fill in. Real values never enter the repository.

# live   - call confcal, Tutu and the enrichment sources, cache in memory with TTL
# replay - read fixtures/ only, never open a socket; the reference date becomes the
#          recorded_at of the fixture manifest
ZAEZD_MODE=live

# Port the process listens on.
PORT=8080

# Absolute base URL of the public deployment. Used to build the link the MCP tools hand back
# and to declare connectDomains in the ui:// resource CSP.
ZAEZD_PUBLIC_URL=https://zaezd.rpa.icu

# Hostname Traefik routes to. Only read by docker-compose.
ZAEZD_HOST=zaezd.rpa.icu

# Nominatim demands a contactable User-Agent and bans anonymous traffic.
ZAEZD_CONTACT_EMAIL=you@example.com

# Upstream MCP endpoints. Defaults match the public servers; override only for a mirror.
ZAEZD_CONFCAL_URL=https://confcal.rpa.icu/mcp
ZAEZD_TUTU_URL=https://mcp.tutu.ru/mcp

# Traefik naming, which differs between installations. This deployment calls its TLS
# entrypoint `https`; the other common name is `websecure`.
ZAEZD_ENTRYPOINT=https
ZAEZD_CERTRESOLVER=letsencrypt
ZAEZD_NETWORK=traefik
