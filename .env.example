# Public MCP endpoints used as data sources. No authentication is required by either.
CONFCAL_MCP_URL=https://confcal.rpa.icu/mcp
TUTU_MCP_URL=https://mcp.tutu.ru/mcp

# live  - call the sources over the network and cache in memory with TTL
# replay - read recorded JSON from fixtures/ and never touch the network
ZAEZD_MODE=live

# Public origin of this deployment. Used to build the /t/:id links returned by MCP tools.
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Nominatim demands a contactable User-Agent, otherwise it bans the caller.
NOMINATIM_USER_AGENT=zaezd/0.1 (contact@example.com)

# Cheap regression bench only (opencode + qwen3.8-27b). Never required by the product.
NEURALDEEP_API_KEY=
