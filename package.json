{
  "name": "zaezd",
  "version": "0.1.0",
  "private": true,
  "description": "Zaezd - trip engine that starts from a reason to travel, not from a city pair",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "node src/main.ts",
    "record": "node --use-env-proxy scripts/record.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "rules:sync": "node scripts/sync-rules.ts",
    "rules:check": "node scripts/sync-rules.ts --check",
    "bdd": "cucumber-js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-assets.ts",
    "verify": "npm run rules:check && npm run typecheck && npm run lint && npm run bdd && npm run test"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
